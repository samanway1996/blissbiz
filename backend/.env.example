DATABASE_URL=mysql+pymysql://blissbiz:replace-with-local-password@127.0.0.1:3307/blissbiz?charset=utf8mb4
APP_ENV=development
ANONYMOUS_SESSION_TTL_SECONDS=900
OWNER_SESSION_TTL_SECONDS=28800
STOREFRONT_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://admin.localhost:5173
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=900
LOGIN_PEER_RATE_LIMIT=20
LOGIN_ACCOUNT_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
# JSON list. Empty for direct local traffic. Production Nginx on this VPS:
# TRUSTED_PROXY_IPS=["127.0.0.1/32","::1/128"]
TRUSTED_PROXY_IPS=[]
# Default: backend/uploads, resolved independently of the shell working directory.
# Production: set an absolute persistent path, for example /var/lib/blissbiz/uploads.
# UPLOAD_DIR=/absolute/path/to/persistent/uploads
# Exact admin UI/API origins only. JSON array; no wildcard or public storefront origins.
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://admin.localhost:5173","http://127.0.0.1:8000","http://localhost:8000","http://admin.localhost:8000"]
