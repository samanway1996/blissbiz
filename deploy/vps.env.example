# Generated privately as deploy/vps.env by scripts/vps-init.sh.
# Do not copy local development credentials. Keep generated hex passwords unchanged
# after MySQL first starts; editing this file does not rotate database credentials.
MYSQL_PASSWORD=replace-with-generated-hex-password
MYSQL_ROOT_PASSWORD=replace-with-different-generated-hex-password
RELEASE_TAG=local
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
NETWORK_SUBNET=172.30.84.0/24
PROXY_IP=172.30.84.10
# TLS_DIR defaults to deploy/tls, resolved relative to compose.vps.yaml.
# Use a directory containing fullchain.pem and privkey.pem.
