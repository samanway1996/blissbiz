# Public build-time configuration (never put secrets in VITE_ variables).
# Development defaults work without creating frontend/.env.
VITE_STOREFRONT_BASE_URL=http://localhost:5173
VITE_ADMIN_BASE_URL=http://admin.localhost:5173
# For production, set both to real HTTPS origins and rebuild.
# Match backend STOREFRONT_BASE_URL, ADMIN_BASE_URL and AUTH_ALLOWED_ORIGINS.
